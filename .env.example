# Supabase (configurar cuando se conecte la base de datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Futuro: integración Ágora TPV
# AGORA_API_URL=
# AGORA_API_TOKEN=

# Impresión Wi-Fi — modo mock por defecto (seguro)
PRINT_MODE=mock
NEXT_PUBLIC_PRINT_MODE=mock

# URL del servidor local de impresión (mini PC del restaurante)
# Si vacío, la PWA usa /api/impresion de Next.js
PRINT_SERVER_URL=http://localhost:3100
NEXT_PUBLIC_PRINT_SERVER_URL=http://localhost:3100

# IPs impresoras ESC/POS (futuro — puerto típico 9100)
PRINTER_COCINA_IP=
PRINTER_BARRA_IP=
PRINTER_POSTRES_IP=
