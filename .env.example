# Backend de datos: local | supabase | hybrid
# Por defecto local — la app usa localStorage como hasta ahora
NEXT_PUBLIC_DATA_BACKEND=local

# Supabase (configurar en Fase 1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RESTAURANTE_ID=

# Solo servidor — migraciones y scripts admin (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Futuro: integración Ágora TPV
# AGORA_API_URL=
# AGORA_API_TOKEN=

# URL del servidor local de impresión (mini PC del restaurante)
# Si vacío, la PWA usa /api/impresion de Next.js
PRINT_SERVER_URL=http://localhost:3100
NEXT_PUBLIC_PRINT_SERVER_URL=http://localhost:3100

# Impresora principal — fallback servidor (preferir /configuracion/impresora en la app)
PRINT_MODE=mock
PRINTER_IP=
PRINTER_PORT=9100
