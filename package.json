{
  "name": "comandero-taberneta",
  "version": "1.0.0",
  "private": true,
  "description": "Comandero web/PWA para La Taberneta de Ca la Ingrid",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "print-server": "node --env-file=print-server/.env print-server/index.js",
    "print-server:dev": "node --env-file=print-server/.env --watch print-server/index.js",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "db:bootstrap": "node scripts/bootstrap-supabase-db.mjs",
    "db:migrate:print-jobs": "node scripts/apply-print-jobs-migration.mjs",
    "vercel:cloud-print": "node scripts/setup-vercel-cloud-print.mjs",
    "ci:validate-secrets": "node scripts/ci/validate-secrets.mjs",
    "ci:vercel-env": "node scripts/ci/configure-vercel-env.mjs",
    "ci:vercel-redeploy": "node scripts/ci/redeploy-vercel.mjs",
    "ci:health": "node scripts/ci/verify-print-health.mjs",
    "ci:seed": "node scripts/ci/seed-via-vercel.mjs",
    "ci:verify-auth": "node scripts/ci/verify-auth-status.mjs",
    "deploy:cloud-print": "node scripts/deploy-cloud-print-all.mjs",
    "setup:all": "node scripts/setup-all.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "idb": "^8.0.3",
    "next": "^15.2.4",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
