# Print-server — Comandero Taberneta

PORT=3100
# Escuchar en todas las interfaces (móviles en la misma WiFi)
PRINT_SERVER_HOST=0.0.0.0

# Opcional: clave para POST /print y /test-connection
# PRINT_API_KEY=cambiar-en-produccion

# Fallback si el móvil no envía impresora en el body
PRINTER_IP=192.168.4.100
PRINTER_PORT=9100
PRINT_MODE=network

# Cola en nube (Vercel → Supabase → Lenovo imprime)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_RESTAURANTE_ID=uuid-del-restaurante
# CLOUD_POLL_MS=3000

# CORS para la PWA en Vercel (separar por comas)
# PRINT_CORS_ORIGINS=https://comandero-taberneta.vercel.app,http://localhost:3000

# Guardar último ticket en print-server/logs/last-ticket.{bin,txt}
# PRINT_DEBUG=1
