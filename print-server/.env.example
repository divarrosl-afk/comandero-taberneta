# Print-server — Comandero Taberneta
# Copiar a print-server/.env y editar valores reales.

PORT=3100
PRINT_SERVER_HOST=0.0.0.0

# Impresora térmica (LAN)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
PRINT_MODE=network

# ─── OBLIGATORIO para imprimir desde Vercel ───────────────────────────────
# Sin estas 3 variables el cloud-poller queda INACTIVO y los tickets de
# Supabase (print_jobs) no se imprimen.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key...
SUPABASE_RESTAURANTE_ID=b1c2d3e4-f5a6-4789-a012-3456789abcde
CLOUD_POLL_MS=3000

# Opcional: clave para POST /print y /test-connection
# PRINT_API_KEY=cambiar-en-produccion

# CORS (solo si usa impresión directa con túnel HTTPS)
# PRINT_CORS_ORIGINS=https://comandero-taberneta.vercel.app

# Debug: guarda último ticket en print-server/logs/last-ticket.{bin,txt}
# PRINT_DEBUG=1
